   "source": [
    "##LASSO (Least Absolute Shrinkage and Selection Operator) is employed as an embedded feature-selection method to identify descriptors with consistent predictive value. \n",
    "#Feature selection is repeated across multiple cross-validation folds, allowing the stability of each descriptor to be quantified.\n",
    "print(\"Feature Selection: LASSO\\n\")\n",
    "\n",
    "masks_lasso_bald = []\n",
    "tracking_lasso_bald = []\n",
    "coef_profiles = []\n",
    "\n",
    "for fold_idx, (train_idx, val_idx) in enumerate(splits_bald, 1):\n",
    "    X_tr, y_tr = X_dev[train_idx], y_dev[train_idx]\n",
    "\n",
    "    # Fix: Unpack the returned tuple to get only the 'kept' indices\n",
    "    kept_indices, _ = remove_correlated_features(X_tr, CORR_THRESHOLD)\n",
    "    scaler = StandardScaler()\n",
    "    X_tr_sc = scaler.fit_transform(X_tr[:, kept_indices])\n",
    "\n",
    "    lasso = LassoCV(cv=4, random_state=SEED, max_iter=50000, n_alphas=150)\n",
    "    lasso.fit(X_tr_sc, y_tr)\n",
    "\n",
    "    coef = np.abs(lasso.coef_)\n",
    "    coef_profiles.append(np.sort(coef)[::-1])\n",
    "    top_filt = np.argsort(coef)[::-1][:K_FEATS_BALD]\n",
    "    # Use kept_indices for original feature mapping\n",
    "    sel_orig = [kept_indices[i] for i in top_filt]\n",
    "    mask = np.zeros(X_dev.shape[1], dtype=bool)\n",
    "    mask[sel_orig] = True\n",
    "    masks_lasso_bald.append(mask)\n",
    "\n",
    "    # Track rank and coefficient for each selected feature\n",
    "    ranks = {}\n",
    "    for rank, fi in enumerate(top_filt):\n",
    "        orig_idx = kept_indices[fi]\n",
    "        ranks[orig_idx] = {\"rank\": rank + 1, \"coef\": float(coef[fi])}\n",
    "\n",
    "    tracking_lasso_bald.append({\n",
    "        \"fold\": fold_idx,\n",
    "        \"features_idx\": sel_orig,\n",
    "        \"features_names\": [feature_names[i] for i in sel_orig],\n",
    "        \"alpha\": lasso.alpha_,\n",
    "        \"ranks\": ranks,\n",
    "    })\n",
    "    print(f\"  Fold {fold_idx}/{n_total_folds_bald} done\")\n",
    "\n",
    "# Coefficient decay plot\n",
    "plot_coef_decay(coef_profiles, K_FEATS_BALD,\n",
    "                'LASSO coefficient decay (Baldassarri)',\n",
    "                save_path='content/lasso_coef_decay_bald.png')\n",
    "\n",
    "# Stability analysis\n",
    "freq_lasso_bald = np.mean(np.vstack(masks_lasso_bald), axis=0)\n",
    "stable_idx_lasso_bald = np.argsort(freq_lasso_bald)[::-1][:K_FEATS_BALD]\n",
    "stable_mask_lasso_bald = np.zeros(X_dev.shape[1], dtype=bool)\n",
    "stable_mask_lasso_bald[stable_idx_lasso_bald] = True\n",
    "\n",
    "# Summary with rank info\n",
    "rank_accumulator = defaultdict(list)\n",
    "coef_accumulator = defaultdict(list)\n",
    "for entry in tracking_lasso_bald:\n",
    "    for idx, info in entry[\"ranks\"].items():\n",
    "        rank_accumulator[idx].append(info[\"rank\"])\n",
    "        coef_accumulator[idx].append(info[\"coef\"])\n",
    "\n",
    "print(f\"\\nTop {K_FEATS_BALD} stable features (LASSO):\")\n",
    "print(f\"  {'Feature':>40} | Stability | Mean Rank | Mean |β|\")\n",
    "print(f\"  {'-'*75}\")\n",
    "for idx in stable_idx_lasso_bald:\n",
    "    freq = freq_lasso_bald[idx]\n",
    "    mean_rank = np.mean(rank_accumulator[idx]) if rank_accumulator[idx] else float('nan')\n",
    "    mean_coef = np.mean(coef_accumulator[idx]) if coef_accumulator[idx] else float('nan')\n",
    "    print(f\"  {feature_names[idx]:>40} | {freq:>8.0%}  | {mean_rank:>9.1f} | {mean_coef:>9.2f}\")"
   ]
