    "##This section evaluates how consistently descriptors are selected across different cross-validation iterations.\n",
    "#Highly stable descriptors are more likely to capture meaningful physicochemical relationships rather than random sampling effects.\n",
    "\n",
    "# LASSO stability\n",
    "feat_counts_lasso = defaultdict(int)\n",
    "for entry in tracking_lasso_bald:\n",
    "    for idx in entry[\"features_idx\"]:\n",
