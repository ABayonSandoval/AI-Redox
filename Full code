    "####################\n",
    "# AUXILIARY FUNCTIONS\n",
    "#This section contains reusable functions that simplify the main workflow. \n",
    "#These functions perform common tasks such as feature selection, model evaluation, statistical analysis, and visualization.\n",
    "####################\n",
    "\n",
    "def remove_correlated_features(X_train, corr_threshold=CORR_THRESHOLD):\n",
    "    corr_matrix = np.corrcoef(X_train.T)\n",
    "    to_drop = set()\n",
    "\n",
    "    for i in range(len(corr_matrix)):\n",
    "        for j in range(i + 1, len(corr_matrix)):\n",
    "            if abs(corr_matrix[i, j]) > corr_threshold:\n",
    "                to_drop.add(j)\n",
    "\n",
    "    kept = [i for i in range(X_train.shape[1]) if i not in to_drop]\n",
    "\n",
    "    print(f\"Removed {len(to_drop)} correlated features (threshold={corr_threshold})\")\n",
    "\n",
    "    return kept, list(to_drop)\n",
    "\n",
    "\n",
    "def bootstrap_ci(y_true, y_pred, n_bootstrap=1000, seed=SEED, ci=95):\n",
    "    mae = mean_absolute_error(y_true, y_pred)\n",
    "    rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
    "    r2 = r2_score(y_true, y_pred)\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = len(y_true)\n",
    "    lo = (100 - ci) / 2\n",
    "    hi = 100 - lo\n",
    "\n",
    "    mae_b, rmse_b, r2_b = [], [], []\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx = rng.choice(n, size=n, replace=True)\n",
    "        mae_b.append(mean_absolute_error(y_true[idx], y_pred[idx]))\n",
    "        rmse_b.append(np.sqrt(mean_squared_error(y_true[idx], y_pred[idx])))\n",
    "        r2_b.append(r2_score(y_true[idx], y_pred[idx]))\n",
    "\n",
    "    return {\n",
    "        'mae': mae,   'mae_ci':  (np.percentile(mae_b, lo),  np.percentile(mae_b, hi)),\n",
    "        'rmse': rmse,  'rmse_ci': (np.percentile(rmse_b, lo), np.percentile(rmse_b, hi)),\n",
    "        'r2': r2,      'r2_ci':   (np.percentile(r2_b, lo),   np.percentile(r2_b, hi)),\n",
    "    }\n",
    "\n",
    "\n",
    "def preds_to_results(preds, n_bootstrap=N_BOOT_SMALL):\n",
    "    results = {}\n",
    "    for model_name, data in preds.items():\n",
    "        yt = data[\"y_true\"]\n",
    "        yp = data[\"y_pred\"]\n",
    "        res = bootstrap_ci(yt, yp, n_bootstrap)\n",
    "        res['y_pred'] = yp\n",
    "        results[model_name] = res\n",
    "    return results\n",
    "\n",
    "\n",
    "def results_to_dataframe(results_dict, strategy_name=\"\"):\n",
    "    rows = []\n",
    "    for model, res in results_dict.items():\n",
    "        if res is None:\n",
    "            continue\n",
    "        rows.append({\n",
    "            'Strategy': strategy_name,\n",
    "            'Model': model,\n",
    "            'MAE': f\"{res['mae']:.2f}\",\n",
    "            'MAE_CI': f\"[{res['mae_ci'][0]:.2f}, {res['mae_ci'][1]:.2f}]\",\n",
    "            'RMSE': f\"{res['rmse']:.2f}\",\n",
    "            'RMSE_CI': f\"[{res['rmse_ci'][0]:.2f}, {res['rmse_ci'][1]:.2f}]\",\n",
    "            'R2': f\"{res['r2']:.4f}\",\n",
    "            'R2_CI': f\"[{res['r2_ci'][0]:.4f}, {res['r2_ci'][1]:.4f}]\",\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def run_loocv(X, y, feature_mask, models_config, n_inner=N_INNER_SPLITS,\n",
    "              do_corr_filter=True, do_lasso_fs=False, k_feats=K_FEATS_VIET):\n",
    "    N = len(y)\n",
    "    loo = LeaveOneOut()\n",
    "\n",
    "    preds = {m: {\"y_true\": np.zeros(N), \"y_pred\": np.zeros(N)}\n",
    "             for m in models_config}\n",
    "    feat_tracking = []\n",
    "\n",
    "    for fold_idx, (tr_idx, te_idx) in enumerate(loo.split(X), 1):\n",
    "        if feature_mask is not None:\n",
    "            X_tr_orig = X[tr_idx][:, feature_mask]\n",
    "            X_te_orig = X[te_idx][:, feature_mask]\n",
    "        else:\n",
    "            X_tr_orig = X[tr_idx]\n",
    "            X_te_orig = X[te_idx]\n",
    "        y_tr = y[tr_idx]\n",
    "        y_te = y[te_idx]\n",
    "\n",
    "        current_kept_indices = list(range(X_tr_orig.shape[1])) # Initialize with all features\n",
    "\n",
    "        if do_corr_filter:\n",
    "            current_kept_indices, _ = remove_correlated_features(X_tr_orig, CORR_THRESHOLD)\n",
    "\n",
    "        X_tr = X_tr_orig[:, current_kept_indices]\n",
    "        X_te = X_te_orig[:, current_kept_indices]\n",
    "\n",
    "        scaler = StandardScaler()\n",
    "        X_tr_sc = scaler.fit_transform(X_tr)\n",
    "        X_te_sc = scaler.transform(X_te)\n",
    "\n",
    "        if do_lasso_fs:\n",
    "            lasso = LassoCV(cv=n_inner, random_state=SEED,\n",
    "                            max_iter=10000, n_alphas=100)\n",
    "            lasso.fit(X_tr_sc, y_tr)\n",
    "            coef = np.abs(lasso.coef_)\n",
    "            top_k = np.argsort(coef)[::-1][:k_feats]\n",
    "            top_k_orig = [current_kept_indices[i] for i in top_k]\n",
    "            X_tr_sc = X_tr_sc[:, top_k]\n",
    "            X_te_sc = X_te_sc[:, top_k]\n",
    "            feat_tracking.append({\n",
    "                \"fold\": fold_idx,\n",
    "                \"features_idx\": top_k_orig,\n",
    "            })\n",
    "\n",
    "        inner_cv = KFold(n_splits=n_inner, shuffle=True, random_state=SEED)\n",
    "        for model_name, config in models_config.items():\n",
    "            gs = GridSearchCV(\n",
    "                config[\"model\"], config[\"params\"],\n",
    "                cv=inner_cv, scoring='neg_mean_absolute_error',\n",
    "                n_jobs=-1, verbose=0\n",
    "            )\n",
    "            gs.fit(X_tr_sc, y_tr)\n",
    "            y_pred = gs.best_estimator_.predict(X_te_sc)\n",
    "            preds[model_name][\"y_true\"][fold_idx - 1] = y_te[0]\n",
    "            preds[model_name][\"y_pred\"][fold_idx - 1] = y_pred[0]\n",
    "\n",
    "        if fold_idx % 20 == 0 or fold_idx == N:\n",
    "            print(f\"  Fold {fold_idx}/{N}\")\n",
    "\n",
    "    return preds, feat_tracking\n",
    "\n",
    "\n",
    "def get_models_config():\n",
    "    return {\n",
    "        \"RandomForest\": {\n",
    "            \"model\": RandomForestRegressor(random_state=SEED),\n",
    "            \"params\": {\n",
    "                \"n_estimators\":     [100, 200, 300],\n",
    "                \"max_depth\":        [5, 8, 10],\n",
    "                \"min_samples_leaf\": [1, 3],\n",
    "                \"max_features\":     [3, 'sqrt'],\n",
    "            }\n",
    "        },\n",
    "        \"GradientBoosting\": {\n",
    "            \"model\": GradientBoostingRegressor(random_state=SEED),\n",
    "            \"params\": {\n",
    "                \"n_estimators\":     [50, 100, 200],\n",
    "                \"learning_rate\":    [0.05, 0.1],\n",
    "                \"max_depth\":        [3, 5],\n",
    "                \"min_samples_leaf\": [5, 10],\n",
    "                \"subsample\":        [0.8],\n",
    "            }\n",
    "        },\n",
    "        \"KRR_Laplacian\": {\n",
    "            \"model\": KernelRidge(kernel=\"laplacian\"),\n",
    "            \"params\": {\n",
    "                \"alpha\": np.logspace(-3, 0, 8),\n",
    "                \"gamma\": np.logspace(-2, 0, 8),\n",
    "            }\n",
    "        },\n",
    "        \"GaussianProcess\": {\n",
    "            \"model\": GaussianProcessRegressor(normalize_y=True, random_state=SEED),\n",
    "            \"params\": {\n",
    "                \"kernel\": [\n",
    "                    C(1.0, (1e-3, 1e3)) * Matern(1.0, nu=0.5,\n",
    "                                                   length_scale_bounds=(1e-2, 1e2)),\n",
    "                    C(1.0, (1e-3, 1e3)) * Matern(1.0, nu=1.5,\n",
    "                                                   length_scale_bounds=(1e-2, 1e2)),\n",
    "                ],\n",
    "                \"alpha\":               [0.5, 1.0, 2.0e-1, 0.5],\n",
    "                \"n_restarts_optimizer\": [5],\n",
    "            }\n",
    "        },\n",
    "    }\n",
    "\n",
    "\n",
    "def get_models_config_small():\n",
    "    return {\n",
    "        \"RandomForest\": {\n",
    "            \"model\": RandomForestRegressor(random_state=SEED),\n",
    "            \"params\": {\n",
    "                \"n_estimators\": [50, 100],\n",
    "                \"max_depth\":    [None, 5, 10],\n",
    "                \"min_samples_leaf\": [1, 2],\n",
    "            }\n",
    "        },\n",
    "        \"GradientBoosting\": {\n",
    "            \"model\": GradientBoostingRegressor(random_state=SEED),\n",
    "            \"params\": {\n",
    "                \"n_estimators\":  [50, 100],\n",
    "                \"learning_rate\": [0.05, 0.1],\n",
    "                \"max_depth\":     [3, 5],\n",
    "            }\n",
    "        },\n",
    "        \"KRR_Laplacian\": {\n",
    "            \"model\": KernelRidge(kernel=\"laplacian\"),\n",
    "            \"params\": {\n",
    "                \"alpha\": np.logspace(-2, 2, 5),\n",
