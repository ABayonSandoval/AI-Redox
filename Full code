    "###Genetic algorithm configuration###\n",
    "##As an alternative to embedded feature selection, a wrapper-based Genetic Algorithm (GA) is employed to directly optimize descriptor subsets according to model performance.\n",
    "\n",
    "print(\"Feature Selection: Genetic Algorithm\\n\")\n",
    "\n",
    "masks_ga_bald = []\n",
    "tracking_ga_bald = []\n",
    "\n",
    "for fold_idx, (train_idx, val_idx) in enumerate(splits_bald, 1):\n",
    "    X_tr, y_tr = X_dev[train_idx], y_dev[train_idx]\n",
    "    print(f\"  Rep {(fold_idx-1)//N_SPLITS_BALD + 1}/{N_REPEATS_BALD}, \"\n",
    "          f\"Fold {(fold_idx-1)%N_SPLITS_BALD + 1}/{N_SPLITS_BALD}\")\n",
    "\n",
    "    # Reset seeds before each fold for reproducibility\n",
    "    np.random.seed(SEED + fold_idx)\n",
    "    random.seed(SEED + fold_idx)\n",
    "\n",
    "    # Fix: Unpack the returned tuple to get only the 'kept' indices\n",
    "    kept_indices, _ = remove_correlated_features(X_tr, CORR_THRESHOLD)\n",
    "    scaler = StandardScaler()\n",
    "    X_tr_sc = scaler.fit_transform(X_tr[:, kept_indices])\n",
    "\n",
    "    #GA Parameters#\n",
    "    ga = GAFeatureSelectionCV(\n",
    "        estimator=KNeighborsRegressor(n_neighbors=5),\n",
    "        cv=4,\n",
    "        scoring='neg_mean_absolute_error',\n",
    "        population_size=200,\n",
    "        generations=50,\n",
    "        crossover_probability=0.75,\n",
    "        mutation_probability=0.2,\n",
    "        tournament_size=2,\n",
    "        elitism=True,\n",
    "        max_features=K_FEATS_BALD,\n",
    "        keep_top_k=20,\n",
    "        n_jobs=1,\n",
    "        verbose=True,\n",
    "    )\n",
    "\n",
    "    early_stop = ConsecutiveStopping(generations=8, metric='fitness')\n",
    "    ga.fit(X_tr_sc, y_tr, callbacks=[early_stop])\n",
    "\n",
    "    mask_filt = None\n",
    "    for ind in ga.hof:\n",
    "        m = np.array(ind, dtype=bool)\n",
    "        if m.sum() == K_FEATS_BALD:\n",
    "            mask_filt = m\n",
    "            break\n",
    "\n",
    "    if mask_filt is None:\n",
    "        best = np.array(ga.hof[0], dtype=bool)\n",
    "        print(f\"    WARNING: No HoF solution with exactly K={K_FEATS_BALD}, \"\n",
    "              f\"best has {best.sum()} features\")\n",
    "        mask_filt = best\n",
    "\n",
    "    # Use kept_indices for original feature mapping\n",
    "    sel_orig = [kept_indices[i] for i in np.where(mask_filt)[0]]\n",
    "    mask = np.zeros(X_dev.shape[1], dtype=bool)\n",
    "    mask[sel_orig] = True\n",
    "    masks_ga_bald.append(mask)\n",
    "    tracking_ga_bald.append({\n",
    "        \"fold\": fold_idx,\n",
    "        \"features_idx\": sel_orig,\n",
    "        \"features_names\": [feature_names[i] for i in sel_orig],\n",
    "    })\n",
    "\n",
    "# Restore global seed\n",
    "np.random.seed(SEED)\n",
    "random.seed(SEED)\n",
    "\n",
    "# Stability analysis\n",
    "freq_ga_bald = np.mean(np.vstack(masks_ga_bald), axis=0)\n",
    "stable_idx_ga_bald = np.argsort(freq_ga_bald)[::-1][:K_FEATS_BALD]\n",
    "stable_mask_ga_bald = np.zeros(X_dev.shape[1], dtype=bool)\n",
    "stable_mask_ga_bald[stable_idx_ga_bald] = True\n",
    "\n",
    "print(f\"\\nTop {K_FEATS_BALD} stable features (GA):\")\n",
    "for idx in stable_idx_ga_bald:\n",
    "    print(f\"  {feature_names[idx]:>40}: {freq_ga_bald[idx]:.1%}\")\n",
    "\n",
    "# Overlap\n",
    "common = set(np.where(stable_mask_ga_bald)[0]) & set(np.where(stable_mask_lasso_bald)[0])\n",
    "print(f\"\\nFeatures in both GA and LASSO: {len(common)}/{K_FEATS_BALD}\")\n",
    "for idx in sorted(common):\n",
    "    print(f\"  {feature_names[idx]}\")"
